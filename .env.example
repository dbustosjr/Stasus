# Public InsForge client config (safe to expose in the browser)
NEXT_PUBLIC_INSFORGE_URL=https://dvmy89mv.us-west.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server-only — never prefix with NEXT_PUBLIC_
# INSFORGE_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides:
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
# Ops: bearer for manual POST to /functions/weekly-insights (also stored in InsForge secrets)
# CRON_SECRET=
# Comma-separated emails allowed to view /admin/usage
# ADMIN_EMAILS=you@example.com
# Server admin key for platform aggregates (never NEXT_PUBLIC_)
# INSFORGE_API_KEY=
